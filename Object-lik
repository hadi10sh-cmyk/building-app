// ثبت کارگر جدید
void addWorker(String name, String job, double dailyRate) {
  final box = Hive.box('workerBox');
  box.put(name, {
    'name': name,
    'job': job,
    'rate': dailyRate,
    'paid': 0.0, // مبلغ پرداختی
    'days': 0.0, // روزهای کارکرده
  });
}

// ثبت پرداخت حقوق
void payWorker(String name, double amount) {
  final box = Hive.box('workerBox');
  var worker = Map<String, dynamic>.from(box.get(name));
  worker['paid'] += amount;
  box.put(name, worker);
}
